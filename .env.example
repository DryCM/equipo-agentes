# Base de datos (Turso, plan gratuito). Sin esto usa un fichero local.db (solo en local).
TURSO_DATABASE_URL=libsql://tu-db.turso.io
TURSO_AUTH_TOKEN=

# LLM con API compatible con OpenAI. Por defecto Google Gemini (plan gratuito de AI Studio).
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Lista separada por comas: si uno da 503/429/404 se prueba el siguiente.
LLM_MODEL=gemini-3.8-flash,gemini-flash-latest,gemini-flash-lite-latest

# Solo para pruebas locales: agentes simulados, sin LLM.
# LLM_MOCK=1
